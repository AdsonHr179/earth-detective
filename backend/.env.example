# Copy these settings into a private environment file; never commit credentials.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_MODEL=mix
# Earthdata Login user token with access to NASA GESDISC DATA ARCHIVE.
EARTHDATA_TOKEN=
# Optional SQLite database path for saved analysis results.
ANALYSIS_DB_PATH=
# Optional explicit HTTP(S) origins, comma-separated, for cross-origin browser requests.
ALLOWED_ORIGINS=
# Optional experimental access to unverified providers. Leave unset in the NASA POWER release.
ENABLE_UNVERIFIED_PROVIDERS=
