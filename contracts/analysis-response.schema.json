{
  "$defs": {
    "AnalysisResponse": {
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "variable_id": {
          "title": "Variable Id",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "requested_period": {
          "$ref": "#/$defs/RequestedPeriod"
        },
        "effective_period": {
          "$ref": "#/$defs/EffectivePeriod"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "region_version": {
          "title": "Region Version",
          "type": "string"
        },
        "spatial_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoJSONPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Series",
          "type": "array"
        },
        "analysis_series": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Analysis Series",
          "type": "array"
        },
        "trend": {
          "$ref": "#/$defs/TrendResult"
        },
        "quality": {
          "title": "Quality",
          "type": "object"
        },
        "explanation": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Explanation",
          "type": "object"
        }
      },
      "required": [
        "analysis_id",
        "schema_version",
        "dataset_version",
        "method_version",
        "variable_id",
        "region_id",
        "requested_period",
        "effective_period",
        "source",
        "product",
        "source_url",
        "retrieved_at",
        "region_version",
        "series",
        "analysis_series",
        "trend",
        "quality",
        "explanation"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "DescriptiveStatistics": {
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "standard_deviation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Standard Deviation"
        }
      },
      "required": [
        "count",
        "mean",
        "median",
        "min",
        "max",
        "standard_deviation"
      ],
      "title": "DescriptiveStatistics",
      "type": "object"
    },
    "EffectivePeriod": {
      "properties": {
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Date"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "EffectivePeriod",
      "type": "object"
    },
    "ForecastPoint": {
      "properties": {
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "value"
      ],
      "title": "ForecastPoint",
      "type": "object"
    },
    "GeoJSONPoint": {
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "enum": [
            "Point"
          ],
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "GeoJSONPoint",
      "type": "object"
    },
    "MonthlyForecast": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ForecastPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "backtest_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backtest Mae"
        },
        "backtest_count": {
          "title": "Backtest Count",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "points",
        "backtest_mae",
        "backtest_count"
      ],
      "title": "MonthlyForecast",
      "type": "object"
    },
    "NasaAnalysisResponse": {
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "variable_id": {
          "title": "Variable Id",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "requested_period": {
          "$ref": "#/$defs/RequestedPeriod"
        },
        "effective_period": {
          "$ref": "#/$defs/EffectivePeriod"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "region_version": {
          "title": "Region Version",
          "type": "string"
        },
        "spatial_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoJSONPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Series",
          "type": "array"
        },
        "analysis_series": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Analysis Series",
          "type": "array"
        },
        "trend": {
          "$ref": "#/$defs/TrendResult"
        },
        "quality": {
          "title": "Quality",
          "type": "object"
        },
        "explanation": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Explanation",
          "type": "object"
        },
        "statistics": {
          "anyOf": [
            {
              "$ref": "#/$defs/DescriptiveStatistics"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonthlyForecast"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "analysis_id",
        "schema_version",
        "dataset_version",
        "method_version",
        "variable_id",
        "region_id",
        "requested_period",
        "effective_period",
        "source",
        "product",
        "source_url",
        "retrieved_at",
        "region_version",
        "series",
        "analysis_series",
        "trend",
        "quality",
        "explanation",
        "statistics",
        "forecast"
      ],
      "title": "NasaAnalysisResponse",
      "type": "object"
    },
    "RequestedPeriod": {
      "properties": {
        "start_date": {
          "title": "Start Date",
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "title": "End Date",
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "RequestedPeriod",
      "type": "object"
    },
    "SeriesPoint": {
      "properties": {
        "timestamp": {
          "title": "Timestamp",
          "type": "string",
          "format": "date"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "quality_flags": {
          "default": "ok",
          "title": "Quality Flags",
          "type": "string"
        },
        "coverage_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Fraction"
        }
      },
      "required": [
        "timestamp",
        "value",
        "unit"
      ],
      "title": "SeriesPoint",
      "type": "object"
    },
    "TrendResult": {
      "properties": {
        "direction": {
          "enum": [
            "increasing",
            "decreasing",
            "stable",
            "undetermined"
          ],
          "title": "Direction",
          "type": "string"
        },
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "slope_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slope Per Decade"
        },
        "slope_unit": {
          "title": "Slope Unit",
          "type": "string"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Value"
        },
        "alpha": {
          "default": 0.05,
          "title": "Alpha",
          "type": "number"
        },
        "estimator": {
          "title": "Estimator",
          "type": "string"
        },
        "inference_method": {
          "title": "Inference Method",
          "type": "string"
        },
        "significant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Significant"
        },
        "inference_status": {
          "enum": [
            "validated",
            "descriptive",
            "insufficient_data",
            "unsupported"
          ],
          "type": "string"
        },
        "inference_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inference Reason"
        }
      },
      "required": [
        "direction",
        "slope_per_decade",
        "slope_unit",
        "confidence_interval",
        "p_value",
        "estimator",
        "inference_method",
        "significant",
        "inference_status",
        "inference_reason",
        "applicable",
        "alpha"
      ],
      "title": "TrendResult",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "inference_status": {
                "const": "validated"
              }
            }
          },
          "then": {
            "properties": {
              "applicable": {
                "const": true
              },
              "slope_per_decade": {
                "type": "number"
              },
              "p_value": {
                "not": {
                  "type": "null"
                }
              },
              "confidence_interval": {
                "not": {
                  "type": "null"
                }
              },
              "significant": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "else": {
            "properties": {
              "inference_reason": {
                "type": "string",
                "minLength": 1
              },
              "p_value": {
                "type": "null"
              },
              "confidence_interval": {
                "type": "null"
              },
              "significant": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inference_status": {
                "const": "descriptive"
              }
            }
          },
          "then": {
            "properties": {
              "applicable": {
                "const": true
              },
              "slope_per_decade": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inference_status": {
                "enum": [
                  "insufficient_data",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "applicable": {
                "const": false
              },
              "slope_per_decade": {
                "type": "null"
              },
              "direction": {
                "const": "undetermined"
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/NasaAnalysisResponse"
    },
    {
      "$ref": "#/$defs/AnalysisResponse"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Earth Detective V1 analysis response",
  "if": {
    "properties": {
      "variable_id": {
        "pattern": "^nasa_"
      }
    }
  },
  "then": {
    "$ref": "#/$defs/NasaAnalysisResponse"
  }
}
